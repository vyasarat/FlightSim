.DS_Store
node_modules/
# Claude Code: the loop's own files are shared (the Stop gate, the two
# reviewers, /cycle and /retro); everything else under .claude/ stays local.
.claude/*
!.claude/settings.json
!.claude/agents/
!.claude/skills/
qa-screenshots/
__pycache__/
*.pyc
*.log
.env
Thumbs.db

# Evidence, recordings and screenshots are never committed: they are what took
# .git to 115 MB. They live here locally (and in Dropbox), not in history.
evidence/
docs/
*.mp4
*.webm
*.gif
qa-screenshots/

# Source models are huge (car 11 MB, fighter 90 MB) and must never be committed:
# they are the raw downloads. Only the processed, decimated models under
# cockpit/models/ are tracked, and those are built by scripts/build_models.js.
models-src/
*.blend
cockpit/models/*.src.glb
reference/
